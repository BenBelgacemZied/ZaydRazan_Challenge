<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZaydRazanChallenge.MainPage"
             Title="Op reis met Zayd en Razan"
             BackgroundColor="{StaticResource Cream}">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">
            <Border BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="22">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🗼 Parijs Challenge" FontSize="30" FontAttributes="Bold" />
                    <Label Text="Leer Frans met Zayd en Razan!" FontSize="18" />
                    <Label x:Name="StarsLabel" Text="⭐ 0" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeThickness="2" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎒 Het avontuur naar Parijs" FontSize="24" FontAttributes="Bold" />
                    <Label x:Name="AdventureProgressLabel" Text="Begin thuis en ontgrendel stap voor stap de reis naar Parijs." FontSize="15" />
                    <ProgressBar x:Name="AdventureProgressBar" ProgressColor="#F59E0B" HeightRequest="8" />
                    <Button x:Name="AdventureButton" Text="▶  Start het avontuur" BackgroundColor="#D97706" Clicked="OnAdventureClicked" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Vrij oefenen" FontSize="22" FontAttributes="Bold" />
            <Button Text="🔗  Woorden verbinden" BackgroundColor="#2563EB" Clicked="OnMatchingClicked" />
            <Label Text="Associe le mot français à sa traduction néerlandaise." FontSize="14" Margin="8,-12,8,0" />
            <Button Text="🔊  Luisteren en kiezen" BackgroundColor="#7C3AED" Clicked="OnListeningClicked" />
            <Label Text="Écoute la prononciation française et choisis le bon mot." FontSize="14" Margin="8,-12,8,0" />
            <Button Text="🏛️  Monumentenquiz" BackgroundColor="#EA580C" Clicked="OnMonumentsClicked" />
            <Label Text="Découvre les monuments de Paris en jouant." FontSize="14" Margin="8,-12,8,0" />
            <Button Text="🧩  Puzzels van Parijs" BackgroundColor="#0891B2" Clicked="OnPuzzleClicked" />
            <Label Text="Reconstruis huit monuments parisiens et complète ta collection." FontSize="14" Margin="8,-12,8,0" />
            <Border BackgroundColor="White" Stroke="#FCD34D" StrokeThickness="2" StrokeShape="RoundRectangle 20" Padding="16">
                <Label Text="⭐ Goed antwoord: +1 ster  •  Fout antwoord: −1 ster. Je voortgang blijft op je telefoon bewaard." FontSize="15" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
