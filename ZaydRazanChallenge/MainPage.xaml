<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZaydRazanChallenge.MainPage"
             Title="ZR LingoTrip"
             BackgroundColor="#DFF4FF">
    <Grid RowDefinitions="Auto,*">
        <Image Grid.RowSpan="2"
               Source="adventure_map.jpg"
               Aspect="AspectFill"
               Opacity="1" />

        <Border Grid.Row="0"
                Margin="12,12,12,0"
                Padding="14,10"
                BackgroundColor="#E6183153"
                Stroke="White"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 22">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label Text="🌍 ZR LingoTrip"
                           TextColor="White"
                           FontSize="21"
                           FontAttributes="Bold" />
                    <Label Text="Met Zayd &amp; Razan · Parijs"
                           TextColor="#DBEAFE"
                           FontSize="13" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       x:Name="StarsLabel"
                       Text="⭐ 0"
                       TextColor="White"
                       FontSize="21"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="12,10,12,18"
              ColumnDefinitions="*,76"
              ColumnSpacing="10">

            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Border Grid.Row="1"
                        Padding="15"
                        Margin="0,0,0,4"
                        BackgroundColor="#F2FFFFFF"
                        Stroke="#F59E0B"
                        StrokeThickness="3"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="🎒 Hoofdavontuur"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#183153" />
                        <Label x:Name="AdventureProgressLabel"
                               Text="Begin de reis en ontgrendel de etappes."
                               FontSize="14"
                               TextColor="#334155" />
                        <ProgressBar x:Name="AdventureProgressBar"
                                     ProgressColor="#F59E0B"
                                     BackgroundColor="#FDE68A"
                                     HeightRequest="8" />
                        <Button x:Name="AdventureButton"
                                Text="▶ Speel het avontuur"
                                FontSize="18"
                                FontAttributes="Bold"
                                BackgroundColor="#E11D48"
                                TextColor="White"
                                CornerRadius="18"
                                HeightRequest="58"
                                Clicked="OnAdventureClicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    VerticalOptions="Center"
                    Padding="7,12"
                    BackgroundColor="#DC183153"
                    Stroke="White"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 28">
                <VerticalStackLayout Spacing="13"
                                     HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="2">
                        <Button Text="🔗"
                                FontSize="23"
                                WidthRequest="56"
                                HeightRequest="56"
                                Padding="0"
                                CornerRadius="28"
                                BackgroundColor="#2563EB"
                                Clicked="OnMatchingClicked" />
                        <Label Text="Mots"
                               FontSize="11"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Button Text="🔊"
                                FontSize="23"
                                WidthRequest="56"
                                HeightRequest="56"
                                Padding="0"
                                CornerRadius="28"
                                BackgroundColor="#7C3AED"
                                Clicked="OnListeningClicked" />
                        <Label Text="Écoute"
                               FontSize="11"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Button Text="🏛️"
                                FontSize="23"
                                WidthRequest="56"
                                HeightRequest="56"
                                Padding="0"
                                CornerRadius="28"
                                BackgroundColor="#EA580C"
                                Clicked="OnMonumentsClicked" />
                        <Label Text="Quiz"
                               FontSize="11"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Button Text="🧩"
                                FontSize="23"
                                WidthRequest="56"
                                HeightRequest="56"
                                Padding="0"
                                CornerRadius="28"
                                BackgroundColor="#0891B2"
                                Clicked="OnPuzzleClicked" />
                        <Label Text="Puzzle"
                               FontSize="11"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
