<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZaydRazanChallenge.App">
    <Application.Resources>
        <Color x:Key="Navy">#183153</Color>
        <Color x:Key="Blue">#3B82F6</Color>
        <Color x:Key="Cream">#FFF8E7</Color>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BackgroundColor" Value="{StaticResource Blue}" />
            <Setter Property="TextColor" Value="White" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Navy}" />
        </Style>
    </Application.Resources>
</Application>
