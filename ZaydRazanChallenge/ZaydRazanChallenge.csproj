<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZaydRazanChallenge</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ZR LingoTrip</ApplicationTitle>
    <ApplicationId>com.zrlingotrip.app</ApplicationId>
    <ApplicationDisplayVersion>2.33</ApplicationDisplayVersion>
    <ApplicationVersion>44</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" BaseSize="1024,1024" />
    <MauiImage Include="Resources/Images/splash.jpg" />
    <MauiImage Include="Resources/Images/adventure_map.jpg" />
    <MauiImage Include="Resources/Images/scene_*.jpg" />
    <MauiImage Include="Resources/Images/mission_pack_*.jpg" />
    <MauiImage Include="Resources/Images/station_*.jpg" />
    <MauiImage Include="Resources/Images/zayd_razan_walk.png" />
    <MauiImage Include="Resources/Images/zayd_razan_official.png" />
    <MauiImage Include="Resources/Images/paris_letter_scene.jpg" />
    <MauiImage Include="Resources/Images/paris_journey_*.jpg" />
    <MauiImage Include="Resources/Images/paris_map_choice.jpg" />
    <MauiImage Include="Resources/Images/paris_ticket_choice.jpg" />
    <MauiImage Include="Resources/Images/paris_*.jpg" Exclude="Resources/Images/paris_letter_scene.jpg;Resources/Images/paris_map_choice.jpg;Resources/Images/paris_ticket_choice.jpg" />
    <MauiImage Include="Resources/Images/*_puzzle.jpg" />
    <MauiImage Include="Resources/Images/Puzzle/*" />
  </ItemGroup>
</Project>
