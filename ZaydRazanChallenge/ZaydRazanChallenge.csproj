<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZaydRazanChallenge</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ZR LingoTrip</ApplicationTitle>
    <ApplicationId>com.zrlingotrip.app</ApplicationId>
    <ApplicationDisplayVersion>2.38</ApplicationDisplayVersion>
    <ApplicationVersion>49</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ZRLingoTrip.Domain/ZRLingoTrip.Domain.csproj" />
    <ProjectReference Include="../ZRLingoTrip.Application/ZRLingoTrip.Application.csproj" />
    <ProjectReference Include="../ZRLingoTrip.Content.Paris/ZRLingoTrip.Content.Paris.csproj" />
    <ProjectReference Include="../ZRLingoTrip.Infrastructure.Maui/ZRLingoTrip.Infrastructure.Maui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" BaseSize="1024,1024" />
    <MauiFont Include="Resources/Fonts/Baloo2.ttf" />
    <!-- Flatten asset names at build time so existing Image.Source values remain stable. -->
    <MauiImage Include="Resources/Images/**/*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
